-Dmaven.wagon.httpconnectionManager.ttlSeconds=120
-Dmaven.wagon.http.retryHandler.requestSentEnabled=true
-Dmaven.wagon.http.retryHandler.count=10
-Dorg.slf4j.simpleLogger.log.org.apache.maven.buildcache=warn
-Dorg.slf4j.simpleLogger.log.org.apache.maven.buildcache.BuildCacheMojosExecutionStrategy=info
-Dorg.slf4j.simpleLogger.log.org.codehaus.mojo.flatten=warn
-Dorg.slf4j.simpleLogger.log.org.apache.maven.surefire.providerapi=warn
